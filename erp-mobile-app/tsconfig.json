{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "sourceMap": true,             // 👈 Enables mapping browser elements to source code
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/app/lib/*": ["../src/app/lib/*"],
      "@/app/utils/*": ["../src/app/utils/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "../src/app/lib/stockCount*.ts", "../src/app/lib/stockLedgerSummary.ts", "../src/app/utils/variationFieldMap.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
